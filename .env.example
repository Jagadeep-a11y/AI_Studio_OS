# ---------------------------------------------------------------------------
# AI Studio OS — environment template
#
# Copy to `.env` (which is git-ignored) and fill in the keys you actually have.
# Every provider is optional: the app runs in clearly-labelled demo mode when
# no keys are present, and lights up each provider as soon as its key exists.
# Never commit `.env`, and never paste keys into the browser.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4173
AI_STUDIO_HOST=0.0.0.0
# SQLite file location. Use ":memory:" for a throwaway database.
AI_STUDIO_DB=./data/studio.db
AI_STUDIO_WORKSPACE=Northstar Studio
# Per-request timeout for upstream provider calls, in milliseconds.
AI_STUDIO_TIMEOUT_MS=60000
# Order used to pick a model when the UI selection is "Auto select".
# Comma-separated provider ids: openai, anthropic, gemini, ollama, mock
AI_STUDIO_PROVIDER_ORDER=openai,anthropic,gemini,ollama,mock

# Where uploaded reference files and generated assets are stored. Defaults to
# `<database folder>/uploads`; point it at a shared volume if you need one.
# Ignored when AI_STUDIO_STORAGE=s3, except as the fallback for older files.
AI_STUDIO_UPLOADS=

# --- Object storage ----------------------------------------------------------
# `local` (default) keeps bytes on this machine. `s3` puts them in any
# S3-compatible bucket — AWS S3, Cloudflare R2, MinIO, Backblaze B2,
# DigitalOcean Spaces, Wasabi — so several servers can share one workspace.
# Switching later is safe: each file row remembers the driver it was written
# with, so older objects stay readable.
AI_STUDIO_STORAGE=local

# Serve a short-lived presigned URL instead of streaming files through the API.
# Faster and cheaper for large files, but anyone holding the link has the bytes
# until it expires. Off by default so every download stays membership-checked.
AI_STUDIO_STORAGE_REDIRECT=0
# How long those signed URLs stay valid.
AI_STUDIO_STORAGE_PRESIGN_MS=300000

# Only read when AI_STUDIO_STORAGE=s3 — but keep them when you switch back, or
# files written while S3 was active become unreadable.
AI_STUDIO_S3_BUCKET=
# Leave empty for AWS; set it for R2/MinIO/etc:
#   Cloudflare R2   https://<account-id>.r2.cloudflarestorage.com
#   MinIO           http://127.0.0.1:9000
#   Backblaze B2    https://s3.<region>.backblazeb2.com
AI_STUDIO_S3_ENDPOINT=
# `auto` is what R2 wants; AWS needs the real region (eu-west-1, us-east-1…).
AI_STUDIO_S3_REGION=auto
# Credentials. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are used as a fallback,
# so an instance with an IAM role or standard AWS env vars needs nothing here.
AI_STUDIO_S3_ACCESS_KEY=
AI_STUDIO_S3_SECRET_KEY=
# Only for temporary (STS) credentials.
AI_STUDIO_S3_SESSION_TOKEN=
# Folder inside the bucket. Objects are also namespaced per workspace under it.
AI_STUDIO_S3_PREFIX=studio
# 1 = path-style URLs (MinIO, most self-hosted gateways). 0 = virtual-hosted
# (`<bucket>.endpoint`), which is what AWS and R2 prefer.
AI_STUDIO_S3_PATH_STYLE=1

# Verify the configuration without starting the server:
#   npm run storage:check

# --- Automations -------------------------------------------------------------
# Scheduler. Disable it to run the studio without any background work.
AI_STUDIO_SCHEDULER=1
# How often the scheduler looks for due workflows, and how many it runs per
# tick per workspace.
AI_STUDIO_SCHEDULER_TICK_MS=30000
AI_STUDIO_SCHEDULER_MAX_PER_TICK=3
# How far ahead a failed workflow's next attempt is pushed.
AI_STUDIO_SCHEDULER_BACKOFF_MS=300000

# Outbound webhooks are OFF until you name the hosts they may call. This one
# line turns the webhook step on for Slack and Discord, without opening a POST
# endpoint into your private network:
#   AI_STUDIO_WEBHOOK_ALLOW=hooks.slack.com,discord.com
# An exact host may point anywhere (including 127.0.0.1, for a local collector).
# A wildcard like *.example.com is refused if it resolves to a private address.
AI_STUDIO_WEBHOOK_ALLOW=
# How long a webhook POST may take before the step fails.
AI_STUDIO_WEBHOOK_TIMEOUT_MS=10000

# --- Accounts and sessions ---------------------------------------------------
# How long a signed-in browser stays signed in. The clock restarts on each visit.
AI_STUDIO_SESSION_TTL_DAYS=30
# How long an invite link stays valid.
AI_STUDIO_INVITE_TTL_DAYS=7
# Set to 0 to close sign-ups once your team is in. Invites keep working, so this
# is the switch to flip before putting a server on the public internet.
AI_STUDIO_ALLOW_SIGNUPS=1
# Attempts allowed per window, per email + IP, before a caller is asked to wait.
AI_STUDIO_LOGIN_MAX_ATTEMPTS=10
AI_STUDIO_SIGNUP_MAX_ATTEMPTS=10
AI_STUDIO_LOGIN_WINDOW_MS=900000
# How many workspaces one person may create.
AI_STUDIO_MAX_WORKSPACES=10
# Session cookies carry the Secure flag automatically when the request arrives
# with `x-forwarded-proto: https` (a TLS-terminating proxy upstream).

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides for gateways, Azure-compatible proxies, or self-hosting.
OPENAI_BASE_URL=
OPENAI_CHAT_PATH=/chat/completions
OPENAI_IMAGES_PATH=/images/generations

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=2023-06-01

# --- Google Gemini ----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=

# --- Ollama (local models, no API key) --------------------------------------
# Set OLLAMA_ENABLED=1 to opt in. Models are discovered from the local daemon.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Development -------------------------------------------------------------
# Set to 1 to silence the per-request log line.
AI_STUDIO_QUIET=0

# --- Demo mode --------------------------------------------------------------
# The mock provider streams a deterministic local draft. It is always available
# as a fallback so the app can be demonstrated without any credentials.
# Set to 0 to make the app return an error instead of falling back to it.
AI_STUDIO_ALLOW_MOCK=1
