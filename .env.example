# ---------------------------------------------------------------------------
# AI Studio OS — environment template
#
# Copy to `.env` (which is git-ignored) and fill in the keys you actually have.
# Every provider is optional: the app runs in clearly-labelled demo mode when
# no keys are present, and lights up each provider as soon as its key exists.
# Never commit `.env`, and never paste keys into the browser.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
PORT=4173
AI_STUDIO_HOST=0.0.0.0
# SQLite file location. Use ":memory:" for a throwaway database.
AI_STUDIO_DB=./data/studio.db
AI_STUDIO_WORKSPACE=Northstar Studio
# Per-request timeout for upstream provider calls, in milliseconds.
AI_STUDIO_TIMEOUT_MS=60000
# Order used to pick a model when the UI selection is "Auto select".
# Comma-separated provider ids: openai, anthropic, gemini, ollama, mock
AI_STUDIO_PROVIDER_ORDER=openai,anthropic,gemini,ollama,mock

# Where uploaded reference files and generated assets are stored. Defaults to
# `<database folder>/uploads`; point it at a shared volume if you need one.
AI_STUDIO_UPLOADS=

# --- Accounts and sessions ---------------------------------------------------
# How long a signed-in browser stays signed in. The clock restarts on each visit.
AI_STUDIO_SESSION_TTL_DAYS=30
# How long an invite link stays valid.
AI_STUDIO_INVITE_TTL_DAYS=7
# Set to 0 to close sign-ups once your team is in. Invites keep working, so this
# is the switch to flip before putting a server on the public internet.
AI_STUDIO_ALLOW_SIGNUPS=1
# Attempts allowed per window, per email + IP, before a caller is asked to wait.
AI_STUDIO_LOGIN_MAX_ATTEMPTS=10
AI_STUDIO_SIGNUP_MAX_ATTEMPTS=10
AI_STUDIO_LOGIN_WINDOW_MS=900000
# How many workspaces one person may create.
AI_STUDIO_MAX_WORKSPACES=10
# Session cookies carry the Secure flag automatically when the request arrives
# with `x-forwarded-proto: https` (a TLS-terminating proxy upstream).

# --- Scheduler ---------------------------------------------------------------
# Automations with clock schedules run inside the server process.
AI_STUDIO_SCHEDULER=1
AI_STUDIO_SCHEDULER_TICK_MS=30000
AI_STUDIO_SCHEDULER_MAX_PER_TICK=3
AI_STUDIO_SCHEDULER_BACKOFF_MS=300000

# --- OpenAI -----------------------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides for gateways, Azure-compatible proxies, or self-hosting.
OPENAI_BASE_URL=
OPENAI_CHAT_PATH=/chat/completions
OPENAI_IMAGES_PATH=/images/generations

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_VERSION=2023-06-01

# --- Google Gemini ----------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=

# --- Ollama (local models, no API key) --------------------------------------
# Set OLLAMA_ENABLED=1 to opt in. Models are discovered from the local daemon.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Development -------------------------------------------------------------
# Set to 1 to silence the per-request log line.
AI_STUDIO_QUIET=0

# --- Demo mode --------------------------------------------------------------
# The mock provider streams a deterministic local draft. It is always available
# as a fallback so the app can be demonstrated without any credentials.
# Set to 0 to make the app return an error instead of falling back to it.
AI_STUDIO_ALLOW_MOCK=1
